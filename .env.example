# OpenAI API key. Never commit the real key to GitHub.
OPENAI_API_KEY=sk-...

# Models can be changed without editing the source code.
OPENAI_TUTOR_MODEL=gpt-5.6-luna
OPENAI_CLASSIFIER_MODEL=gpt-5.6-luna
OPENAI_MODERATION_MODEL=omni-moderation-latest

# How many recent dialogue messages are sent back to the tutor model.
CHAT_HISTORY_MESSAGES=10

# Teacher dashboard looks at this recent time window by default.
DASHBOARD_WINDOW_MINUTES=120

# Simple protection for the teacher dashboard in this prototype.
# Replace this mechanism with proper authentication before production use.
TEACHER_PIN=1234
SESSION_SECRET=change-me-to-a-long-random-string

# Development server settings
HOST=127.0.0.1
PORT=8000

# Number of earlier visible student/tutor messages restored after login.
DISPLAY_HISTORY_MESSAGES=60
